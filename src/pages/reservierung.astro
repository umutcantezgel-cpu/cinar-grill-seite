---
/**
 * Reservierung - Cinar Grill
 * Table reservation form
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

// SEO Data
const seoRouteData = await import('../../contracts/seo.routes.json');
const reservationRoute = seoRouteData.routes.find((r) => r.path === '/reservierung');
---

<BaseLayout
  title={reservationRoute?.meta.title || 'Tisch reservieren - Cinar Grill'}
  description={reservationRoute?.meta.description || ''}
  canonical="/reservierung"
  ogImage="/assets/img/og-reservation.jpg"
>
  <Navigation slot="header" />

  <!-- Page Header -->
  <section class="section bg-warm-beige-50 pt-32 pb-16">
    <div class="container-custom max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-charcoal-950 mb-4">
        Tisch reservieren
      </h1>
      <p class="text-lg md:text-xl text-charcoal-700">
        Sichern Sie sich Ihren Platz bei Cinar Grill. Wir freuen uns auf Ihren Besuch!
      </p>
    </div>
  </section>

  <!-- Reservation Form -->
  <section class="section">
    <div class="container-custom max-w-2xl">
      <div class="glass-card rounded-2xl p-8 md:p-12">
        <form
          name="reservation"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <!-- Honeypot field (hidden) -->
          <input type="hidden" name="form-name" value="reservation" />
          <div class="hidden">
            <label>
              Don't fill this out if you're human: <input name="bot-field" />
            </label>
          </div>

          <!-- Name -->
          <div>
            <label for="name" class="form-label">
              Name <span class="text-glut-950">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="form-input"
              placeholder="Ihr Name"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="form-label">
              E-Mail <span class="text-glut-950">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="form-input"
              placeholder="ihre@email.de"
            />
          </div>

          <!-- Phone -->
          <div>
            <label for="phone" class="form-label">
              Telefon <span class="text-glut-950">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              class="form-input"
              placeholder="+49 ..."
            />
            <p class="text-sm text-charcoal-600 mt-1">
              Für Rückfragen zu Ihrer Reservierung
            </p>
          </div>

          <!-- Date -->
          <div>
            <label for="date" class="form-label">
              Datum <span class="text-glut-950">*</span>
            </label>
            <input
              type="date"
              id="date"
              name="date"
              required
              class="form-input"
              min={new Date().toISOString().split('T')[0]}
            />
          </div>

          <!-- Time -->
          <div>
            <label for="time" class="form-label">
              Uhrzeit <span class="text-glut-950">*</span>
            </label>
            <select id="time" name="time" required class="form-input">
              <option value="">Bitte wählen...</option>
              <option value="11:00">11:00 Uhr</option>
              <option value="11:30">11:30 Uhr</option>
              <option value="12:00">12:00 Uhr</option>
              <option value="12:30">12:30 Uhr</option>
              <option value="13:00">13:00 Uhr</option>
              <option value="13:30">13:30 Uhr</option>
              <option value="14:00">14:00 Uhr</option>
              <option value="17:00">17:00 Uhr</option>
              <option value="17:30">17:30 Uhr</option>
              <option value="18:00">18:00 Uhr</option>
              <option value="18:30">18:30 Uhr</option>
              <option value="19:00">19:00 Uhr</option>
              <option value="19:30">19:30 Uhr</option>
              <option value="20:00">20:00 Uhr</option>
              <option value="20:30">20:30 Uhr</option>
              <option value="21:00">21:00 Uhr</option>
            </select>
          </div>

          <!-- Number of Guests -->
          <div>
            <label for="guests" class="form-label">
              Anzahl Personen <span class="text-glut-950">*</span>
            </label>
            <select id="guests" name="guests" required class="form-input">
              <option value="">Bitte wählen...</option>
              <option value="1">1 Person</option>
              <option value="2">2 Personen</option>
              <option value="3">3 Personen</option>
              <option value="4">4 Personen</option>
              <option value="5">5 Personen</option>
              <option value="6">6 Personen</option>
              <option value="7">7 Personen</option>
              <option value="8">8 Personen</option>
              <option value="9">9 Personen</option>
              <option value="10">10 Personen</option>
              <option value="mehr">Mehr als 10 Personen</option>
            </select>
          </div>

          <!-- Special Requests -->
          <div>
            <label for="message" class="form-label">
              Besondere Wünsche (optional)
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="form-input"
              placeholder="z.B. Hochstuhl, Allergien, besondere Anlässe..."
            ></textarea>
          </div>

          <!-- Privacy Checkbox -->
          <div class="flex items-start gap-2">
            <input
              type="checkbox"
              id="privacy"
              name="privacy"
              required
              class="mt-1"
            />
            <label for="privacy" class="text-sm text-charcoal-700">
              Ich habe die{' '}
              <a href="/datenschutz" class="text-glut-950 hover:underline">
                Datenschutzerklärung
              </a>{' '}
              gelesen und stimme der Verarbeitung meiner Daten zum Zweck der Reservierung zu.{' '}
              <span class="text-glut-950">*</span>
            </label>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn-primary w-full text-lg">
            Jetzt reservieren
          </button>

          <p class="text-sm text-charcoal-600 text-center">
            * Pflichtfelder
          </p>

          <!-- Info Box -->
          <div class="bg-warm-beige-100 border-l-4 border-gold-600 p-4 rounded">
            <p class="text-sm text-charcoal-700">
              <strong>Hinweis:</strong> Ihre Reservierung wird nach Absenden des Formulars per E-Mail
              bestätigt. Bei Fragen erreichen Sie uns unter{' '}
              <a href="tel:+49TODO" class="text-glut-950 hover:underline">+49 TODO</a>.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Contact Info -->
  <section class="section bg-charcoal-50">
    <div class="container-custom max-w-4xl text-center">
      <h2 class="text-2xl font-semibold text-charcoal-950 mb-4">
        Lieber telefonisch reservieren?
      </h2>
      <p class="text-lg text-charcoal-700 mb-6">
        Rufen Sie uns gerne direkt an – wir freuen uns auf Ihren Anruf!
      </p>
      <a href="tel:+49TODO" class="btn-primary inline-flex">
        <span class="mr-2" aria-hidden="true">📞</span>
        +49 TODO anrufen
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
