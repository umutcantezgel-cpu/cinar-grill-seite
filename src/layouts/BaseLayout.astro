---
import '../styles/global.css';
import type { SEOProps } from '@/types/seo';

interface Props {
  seo: SEOProps;
  noIndex?: boolean;
  structuredData?: object[];
}

const { seo, noIndex = false, structuredData = [] } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="de-DE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.keywords && <meta name="keywords" content={seo.keywords.join(', ')} />}
    <link rel="canonical" href={seo.canonical} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Open Graph -->
    <meta property="og:type" content={seo.ogType || 'website'} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Cinar Grill" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={seo.twitterCard || 'summary_large_image'} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Preconnect (no external resources before consent) -->

    <!-- Structured Data (JSON-LD) -->
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        ...data
      })} />
    ))}

    <!-- Security Headers (via meta where possible) -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

    <!-- Performance Hints -->
    <link rel="preload" href="/assets/font/inter-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/font/playfair-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Skip Links -->
    <a href="#main-content" class="skip-link">Zum Hauptinhalt springen</a>
    <a href="#main-navigation" class="skip-link">Zur Navigation springen</a>

    <!-- Consent Banner (will be injected by ConsentBanner component) -->
    <div id="consent-banner-root"></div>

    <!-- Header -->
    <header class="site-header">
      <div class="container">
        <div class="header-content">
          <a href="/" class="logo-link" aria-label="Cinar Grill Startseite">
            <span class="logo-text">Cinar <span class="logo-accent">Grill</span></span>
          </a>

          <nav id="main-navigation" aria-label="Hauptnavigation" class="main-nav">
            <ul class="nav-list" role="list">
              <li><a href="/" class="nav-link">Start</a></li>
              <li><a href="/speisekarte" class="nav-link">Speisekarte</a></li>
              <li><a href="/ueber-uns" class="nav-link">Über Uns</a></li>
              <li><a href="/referenzen" class="nav-link">Bewertungen</a></li>
              <li><a href="/kontakt" class="nav-link">Kontakt</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section">
            <h3 class="footer-heading">Cinar Grill</h3>
            <p>Authentische türkische Küche seit {currentYear}</p>
          </div>

          <div class="footer-section">
            <h3 class="footer-heading">Kontakt</h3>
            <address class="footer-address">
              <p>TODO: Straße Nr.</p>
              <p>TODO: PLZ Stadt</p>
              <p>Tel: <a href="tel:+49XXXXXXXXX">+49 XXX XXXXXXX</a></p>
              <p>Email: <a href="mailto:info@cinar-grill.de">info@cinar-grill.de</a></p>
            </address>
          </div>

          <div class="footer-section">
            <h3 class="footer-heading">Öffnungszeiten</h3>
            <p>Montag - Sonntag<br>11:00 - 23:00 Uhr</p>
          </div>

          <div class="footer-section">
            <h3 class="footer-heading">Rechtliches</h3>
            <ul class="footer-legal" role="list">
              <li><a href="/impressum">Impressum</a></li>
              <li><a href="/datenschutz">Datenschutz</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {currentYear} Cinar Grill. Alle Rechte vorbehalten.</p>
        </div>
      </div>
    </footer>

    <style>
      /* Header */
      .site-header {
        background-color: var(--color-surface-base);
        border-bottom: 1px solid var(--color-border-subtle);
        position: sticky;
        top: 0;
        z-index: var(--z-navigation);
        box-shadow: var(--shadow-card);
      }

      .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: var(--nav-height);
        gap: var(--space-container);
      }

      .logo-link {
        text-decoration: none;
        font-family: var(--font-family-heading);
        font-size: var(--font-size-heading-md);
        font-weight: var(--font-weight-bold);
        color: var(--color-text-primary);
      }

      .logo-accent {
        color: var(--color-brand-accent);
      }

      .main-nav {
        flex: 1;
        display: flex;
        justify-content: flex-end;
      }

      .nav-list {
        display: flex;
        gap: var(--space-container);
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-link {
        padding: var(--space-element-sm) var(--space-element);
        color: var(--color-text-primary);
        text-decoration: none;
        font-weight: var(--font-weight-medium);
        border-radius: var(--border-radius-sm);
        transition: color var(--transition-fast), background-color var(--transition-fast);
        min-height: 44px;  /* Touch target */
        display: flex;
        align-items: center;
      }

      .nav-link:hover,
      .nav-link:focus {
        color: var(--color-brand-primary);
        background-color: var(--color-neutral-50);
      }

      /* Footer */
      .site-footer {
        background-color: var(--footer-background);
        color: var(--footer-color);
        padding: var(--footer-padding-y) 0;
        margin-top: var(--space-section-lg);
      }

      .footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: var(--space-container-lg);
        margin-bottom: var(--space-container-lg);
      }

      .footer-heading {
        color: var(--color-brand-accent);
        margin-bottom: var(--space-element);
        font-size: var(--font-size-heading-sm);
      }

      .footer-address {
        font-style: normal;
      }

      .footer-legal {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .footer-legal li {
        margin-bottom: var(--space-element-sm);
      }

      .site-footer a {
        color: var(--footer-color);
        text-decoration: underline;
      }

      .site-footer a:hover,
      .site-footer a:focus {
        color: var(--color-brand-accent);
      }

      .footer-bottom {
        text-align: center;
        padding-top: var(--space-container);
        border-top: 1px solid var(--color-neutral-800);
        font-size: var(--font-size-body-sm);
      }

      /* Responsive */
      @media (max-width: 768px) {
        .header-content {
          flex-direction: column;
          align-items: flex-start;
          padding: var(--space-container-sm) 0;
        }

        .main-nav {
          width: 100%;
        }

        .nav-list {
          flex-direction: column;
          gap: var(--space-element-sm);
          width: 100%;
        }

        .nav-link {
          width: 100%;
        }

        .footer-content {
          grid-template-columns: 1fr;
          gap: var(--space-container);
        }
      }
    </style>
  </body>
</html>
