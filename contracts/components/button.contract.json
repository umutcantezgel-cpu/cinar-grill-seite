{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://cinargrill.de/schemas/components/button.contract.json",
  "version": "1.0.0",
  "component": {
    "name": "Button",
    "description": "Accessible, performant button component with multiple variants",
    "category": "interactive",
    "tags": ["form", "cta", "navigation"]
  },
  "props": {
    "variant": {
      "type": "string",
      "enum": ["primary", "secondary", "ghost", "danger"],
      "default": "primary",
      "description": "Visual variant of the button"
    },
    "size": {
      "type": "string",
      "enum": ["sm", "md", "lg"],
      "default": "md",
      "description": "Button size"
    },
    "href": {
      "type": "string",
      "required": false,
      "description": "If provided, renders as link instead of button"
    },
    "type": {
      "type": "string",
      "enum": ["button", "submit", "reset"],
      "default": "button",
      "description": "HTML button type attribute"
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "description": "Disabled state"
    },
    "loading": {
      "type": "boolean",
      "default": false,
      "description": "Loading state with spinner"
    },
    "fullWidth": {
      "type": "boolean",
      "default": false,
      "description": "Stretch to full width"
    },
    "ariaLabel": {
      "type": "string",
      "required": false,
      "description": "Accessible label for icon-only buttons"
    }
  },
  "accessibility": {
    "requirements": {
      "minTargetSize": 44,
      "focusVisible": true,
      "keyboardAccessible": true,
      "ariaLabelRequired": "when icon-only",
      "disabledState": "aria-disabled attribute",
      "loadingState": "aria-busy attribute"
    },
    "wcag": {
      "level": "AA",
      "criteria": ["2.1.1", "2.4.7", "2.5.5", "4.1.2"]
    }
  },
  "performance": {
    "budgets": {
      "css": 500,
      "js": 0
    },
    "optimizations": {
      "inlineStyles": false,
      "lazyLoad": false,
      "prefetch": false
    }
  },
  "consent": {
    "required": false,
    "categories": []
  },
  "variants": {
    "primary": {
      "description": "Main CTA button",
      "background": "var(--color-primary-glut)",
      "color": "var(--color-neutral-white)",
      "hover": {
        "background": "var(--color-primary-glut-dark)",
        "transform": "translateY(-2px)",
        "shadow": "var(--shadow-md)"
      }
    },
    "secondary": {
      "description": "Secondary actions",
      "background": "var(--color-neutral-smoke)",
      "color": "var(--color-primary-charcoal)",
      "hover": {
        "background": "var(--color-neutral-slate-light)"
      }
    },
    "ghost": {
      "description": "Tertiary, low-emphasis actions",
      "background": "transparent",
      "color": "var(--color-primary-glut)",
      "border": "1px solid var(--color-primary-glut)",
      "hover": {
        "background": "var(--color-primary-glut-alpha-10)"
      }
    },
    "danger": {
      "description": "Destructive actions",
      "background": "var(--color-danger)",
      "color": "var(--color-neutral-white)",
      "hover": {
        "background": "var(--color-danger-dark)"
      }
    }
  },
  "states": {
    "default": {},
    "hover": {
      "transition": "all 200ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "focus": {
      "outline": "2px solid var(--color-focus)",
      "outlineOffset": "2px"
    },
    "active": {
      "transform": "translateY(0)"
    },
    "disabled": {
      "opacity": 0.5,
      "cursor": "not-allowed",
      "pointerEvents": "none"
    },
    "loading": {
      "cursor": "wait"
    }
  },
  "examples": [
    {
      "name": "Primary CTA",
      "code": "<Button variant=\"primary\" size=\"lg\">Jetzt reservieren</Button>"
    },
    {
      "name": "Secondary Link",
      "code": "<Button variant=\"secondary\" href=\"/speisekarte\">Speisekarte ansehen</Button>"
    },
    {
      "name": "Icon-only",
      "code": "<Button variant=\"ghost\" ariaLabel=\"Menü öffnen\"><Icon name=\"menu\" /></Button>"
    }
  ]
}
