{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://cinargrill.de/schemas/components/navigation.contract.json",
  "version": "1.0.0",
  "component": {
    "name": "Navigation",
    "description": "Main site navigation with responsive behavior and glassmorphism effect",
    "category": "navigation",
    "tags": ["header", "menu", "responsive"]
  },
  "props": {
    "items": {
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "properties": {
          "label": {"type": "string", "required": true},
          "href": {"type": "string", "required": true},
          "external": {"type": "boolean", "default": false},
          "children": {"type": "array", "required": false}
        }
      }
    },
    "sticky": {
      "type": "boolean",
      "default": true,
      "description": "Sticky header on scroll"
    },
    "glassmorphism": {
      "type": "boolean",
      "default": true,
      "description": "Enable glassmorphism effect when scrolled"
    }
  },
  "accessibility": {
    "requirements": {
      "landmark": "nav",
      "ariaLabel": "Hauptnavigation",
      "keyboardNavigation": true,
      "focusManagement": true,
      "skipLink": true,
      "mobileMenuAnnouncement": "aria-live region for menu state"
    },
    "wcag": {
      "level": "AA",
      "criteria": ["2.1.1", "2.4.1", "2.4.3", "2.4.7", "4.1.2"]
    }
  },
  "performance": {
    "budgets": {
      "css": 2000,
      "js": 3000
    },
    "optimizations": {
      "throttleScroll": true,
      "deferNonCritical": true,
      "useWillChange": false
    }
  },
  "consent": {
    "required": false,
    "categories": []
  },
  "behavior": {
    "desktop": {
      "layout": "horizontal",
      "dropdown": false,
      "sticky": true,
      "glassmorphismOnScroll": true
    },
    "mobile": {
      "layout": "hamburger",
      "overlay": true,
      "animation": "slide-in-right",
      "bodyScrollLock": true,
      "closeOnNavigate": true,
      "closeOnEscape": true,
      "closeOnOutsideClick": true
    }
  },
  "glassmorphism": {
    "background": "rgba(255, 255, 255, 0.7)",
    "backdropFilter": "blur(10px) saturate(180%)",
    "border": "1px solid rgba(255, 255, 255, 0.3)",
    "boxShadow": "0 8px 32px rgba(0, 0, 0, 0.1)",
    "transition": "all 300ms cubic-bezier(0.4, 0, 0.2, 1)",
    "darkMode": {
      "background": "rgba(45, 45, 45, 0.8)",
      "border": "1px solid rgba(255, 255, 255, 0.1)"
    }
  },
  "states": {
    "default": {
      "background": "transparent",
      "shadow": "none"
    },
    "scrolled": {
      "background": "glassmorphism",
      "shadow": "var(--shadow-md)"
    },
    "mobileOpen": {
      "bodyOverflow": "hidden",
      "zIndex": 1000
    }
  },
  "events": {
    "emits": [
      "navigation.opened",
      "navigation.closed"
    ],
    "listens": []
  }
}
