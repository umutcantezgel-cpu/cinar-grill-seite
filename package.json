{
  "name": "cinar-grill-website",
  "version": "1.0.0",
  "description": "Premium restaurant website for Cinar Grill with enterprise-grade quality",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lhci": "lhci autorun",
    "a11y": "npm run a11y:axe && npm run a11y:pa11y",
    "a11y:axe": "node scripts/a11y-axe.js",
    "a11y:pa11y": "pa11y-ci",
    "links": "hyperlink -r -i dist/",
    "sri:gen": "node scripts/gen-sri.js",
    "sri:verify": "node scripts/verify-sri.js",
    "security": "npm run security:headers && npm run security:no-inline",
    "security:headers": "node scripts/check-security-headers.js",
    "security:no-inline": "node scripts/check-no-inline.js",
    "reports": "node scripts/generate-reports.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.15.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.0",
    "@lhci/cli": "^0.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "hyperlink": "^5.0.0",
    "pa11y-ci": "^3.1.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/umutcantezgel-cpu/cinar-grill-seite"
  },
  "keywords": [
    "restaurant",
    "website",
    "astro",
    "tailwindcss",
    "premium",
    "accessibility",
    "performance",
    "security"
  ],
  "author": "Cinar Grill",
  "license": "UNLICENSED"
}
